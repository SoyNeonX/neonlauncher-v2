<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import org.kordamp.ikonli.materialdesign2.MaterialDesignM?>

<ScrollPane xmlns:fx="http://javafx.com/fxml/1" fitToWidth="true" styleClass="profile-view">
    <VBox spacing="20" alignment="TOP_CENTER">
        <padding><Insets top="30" right="40" bottom="40" left="40"/></padding>
        
        <VBox spacing="15" alignment="CENTER" styleClass="profile-header-card">
            <ImageView fx:id="skinImage" fitWidth="128" fitHeight="128" preserveRatio="true"/>
            <Label fx:id="usernameLabel" text="No conectado" styleClass="username-label"/>
            <Label fx:id="uuidLabel" text="" styleClass="uuid-label"/>
            <Button fx:id="logoutBtn" text="Cerrar sesión" styleClass="secondary-button" visible="false"/>
        </VBox>
        
        <Separator/>
        
        <VBox spacing="15" styleClass="settings-card" maxWidth="600">
            <Label text="Configuración de Java" styleClass="section-title"/>
            
            <GridPane hgap="15" vgap="10">
                <Label text="Java Runtime:"/>
                <ComboBox fx:id="javaComboBox" GridPane.columnIndex="1" prefWidth="400"/>
                
                <Label text="Memoria RAM (MB):"/>
                <Slider fx:id="memorySlider" min="1024" max="16384" majorTickUnit="1024" blockIncrement="512" showTickLabels="true" showTickMarks="true" GridPane.columnIndex="1"/>
                <Label fx:id="memoryLabel" text="4096 MB" GridPane.columnIndex="2"/>
                
                <Label text="Argumentos JVM personalizados:"/>
                <TextArea fx:id="jvmArgsArea" prefRowCount="3" GridPane.columnIndex="1" GridPane.columnSpan="2"/>
            </GridPane>
        </VBox>
        
        <VBox spacing="15" styleClass="settings-card" maxWidth="600">
            <Label text="Configuración de Ventana" styleClass="section-title"/>
            
            <GridPane hgap="15" vgap="10">
                <Label text="Ancho:"/>
                <Spinner fx:id="widthSpinner" initialValue="1280" min="800" max="3840" stepFactor="1" GridPane.columnIndex="1"/>
                
                <Label text="Alto:"/>
                <Spinner fx:id="heightSpinner" initialValue="720" min="600" max="2160" stepFactor="1" GridPane.columnIndex="1"/>
                
                <CheckBox fx:id="fullscreenCheck" text="Pantalla completa" GridPane.columnIndex="1"/>
            </GridPane>
        </VBox>
        
        <Button fx:id="saveProfileBtn" text="Guardar perfil" styleClass="primary-button" prefWidth="200"/>
    </VBox>
</ScrollPane>