<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import org.kordamp.ikonli.materialdesign2.MaterialDesignM?>

<ScrollPane xmlns:fx="http://javafx.com/fxml/1" fitToWidth="true" styleClass="settings-view">
    <VBox spacing="20" alignment="TOP_CENTER">
        <padding><Insets top="30" right="40" bottom="40" left="40"/></padding>
        
        <Label text="Configuración del Launcher" styleClass="view-title"/>
        
        <VBox spacing="15" styleClass="settings-card" maxWidth="700">
            <Label text="General" styleClass="section-title"/>
            
            <GridPane hgap="15" vgap="12">
                <Label text="Idioma:"/>
                <ComboBox fx:id="languageCombo" GridPane.columnIndex="1" prefWidth="200"/>
                
                <Label text="Tema:"/>
                <ComboBox fx:id="themeCombo" GridPane.columnIndex="1" prefWidth="200"/>
                
                <Label text="Canal de actualizaciones:"/>
                <ComboBox fx:id="updateChannelCombo" GridPane.columnIndex="1" prefWidth="200"/>
                
                <CheckBox fx:id="autoUpdateCheck" text="Actualizar automáticamente el launcher" GridPane.columnIndex="1"/>
                <CheckBox fx:id="checkUpdatesStartup" text="Comprobar actualizaciones al inicio" GridPane.columnIndex="1"/>
                <CheckBox fx:id="minimizeOnLaunchCheck" text="Minimizar al iniciar juego" GridPane.columnIndex="1"/>
                <CheckBox fx:id="closeOnLaunchCheck" text="Cerrar launcher al iniciar juego" GridPane.columnIndex="1"/>
                <CheckBox fx:id="showConsoleCheck" text="Mostrar consola del juego" GridPane.columnIndex="1"/>
            </GridPane>
        </VBox>
        
        <VBox spacing="15" styleClass="settings-card" maxWidth="700">
            <Label text="Descargas" styleClass="section-title"/>
            
            <GridPane hgap="15" vgap="12">
                <Label text="Hilos de descarga simultáneos:"/>
                <Spinner fx:id="downloadThreadsSpinner" initialValue="4" min="1" max="16" GridPane.columnIndex="1" prefWidth="100"/>
                
                <CheckBox fx:id="verifyHashesCheck" text="Verificar hashes SHA-256 de mods" GridPane.columnIndex="1"/>
            </GridPane>
        </VBox>
        
        <VBox spacing="15" styleClass="settings-card" maxWidth="700">
            <Label text="Servidor" styleClass="section-title"/>
            
            <GridPane hgap="15" vgap="12">
                <Label text="URL del Manifest:"/>
                <TextField fx:id="manifestUrlField" GridPane.columnIndex="1" prefWidth="500"/>
                
                <Label text="URL base de Mods (CDN):"/>
                <TextField fx:id="modsBaseUrlField" GridPane.columnIndex="1" prefWidth="500"/>
            </GridPane>
        </VBox>
        
        <VBox spacing="15" styleClass="settings-card" maxWidth="700">
            <Label text="Acerca de" styleClass="section-title"/>
            
            <GridPane hgap="15" vgap="8">
                <Label text="Versión del Launcher:"/>
                <Label fx:id="launcherVersionLabel" text="1.0.0" GridPane.columnIndex="1"/>
                
                <Label text="JavaFX Version:"/>
                <Label fx:id="javafxVersionLabel" GridPane.columnIndex="1"/>
                
                <Label text="Directorio de datos:"/>
                <Label fx:id="dataDirLabel" GridPane.columnIndex="1"/>
            </GridPane>
        </VBox>
        
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button fx:id="resetSettingsBtn" text="Restablecer" styleClass="secondary-button"/>
            <Button fx:id="saveSettingsBtn" text="Guardar" styleClass="primary-button"/>
        </HBox>
    </VBox>
</ScrollPane>