<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import org.kordamp.ikonli.materialdesign2.MaterialDesignM?>

<VBox xmlns:fx="http://javafx.com/fxml/1" spacing="20" alignment="CENTER" styleClass="login-view">
    <padding><Insets top="50" right="50" bottom="50" left="50"/></padding>
    
    <Label text="NeonLauncher" styleClass="login-title"/>
    <Label text="Inicia sesión para acceder a tu servidor" styleClass="login-subtitle"/>
    
    <VBox spacing="15" maxWidth="400" alignment="CENTER">
        <Button fx:id="microsoftLoginBtn" text="Iniciar con Microsoft" styleClass="primary-button" maxWidth="Infinity" prefHeight="48">
            <graphic>
                <FontIcon iconLiteral="mdi-microsoft" iconSize="24"/>
            </graphic>
        </Button>
        
        <Separator/>
        
        <CheckBox fx:id="offlineModeCheck" text="Modo offline (sin autenticación)"/>
        
        <Button fx:id="playOfflineBtn" text="Jugar offline" styleClass="secondary-button" maxWidth="Infinity" prefHeight="40"/>
    </VBox>
    
    <ProgressIndicator fx:id="authProgress" visible="false" progress="-1.0"/>
    <Label fx:id="authStatusLabel" text="" styleClass="status-text" wrapText="true" maxWidth="400"/>
</VBox>